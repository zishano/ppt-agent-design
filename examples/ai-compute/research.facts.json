      "source_sha256": "94c69f01f1e0be24dc057180af6db878d1f5339fd31d54cbe5c386f8e198ce08"
    },
    {
      "fact_id": "F017",
      "claim": "NVIDIA DCGM 的 GPU 集群管理能力包含健康监测、诊断以及功率和时钟管理。",
      "source_title": "NVIDIA Data Center GPU Manager README",
      "source_url": "https://raw.githubusercontent.com/NVIDIA/DCGM/master/README.md",
